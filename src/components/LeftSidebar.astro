---
import { Image } from "astro:assets";
import { SIDEBAR } from "../data/sidebar.js";
const { pathname } = new URL(Astro.request.url);
---

<nav
	class="site-nav"
>
	{/* Previously:
	<a href="/">
		<img
			src="/assets/muncss_stacked_bw.svg"
			class="mx-auto md:mx-0 my-4 w-1/2 md:w-11/12 dark:invert py-1 px-1 lg:px-4 2xl:px-5"
		/>
	</a>
	*/}
	<a href="/">
		<div class="site-logo">
			<Image
				src="/assets/muncss_stacked_bw.svg"
				loading="eager"
				transition:persist="society-logo"
				transition:animate="none"
				width="1316"
				height="1740"
				alt="Memorial University Computer Science Society"
				class="w-full h-auto dark:invert"
				style="aspect-ratio: 1315.5333 / 1739.48"
			/>
		</div>
	</a>
	<ul>
		{
			SIDEBAR.map((section) => (
				<li>
					<a
						href={section.link}
						class="hover:underline"
						aria-current={section.link === pathname ? "true" : "false"}
					>
						<h2 class="text-xl font-semibold my-1">{section.text}</h2>
					</a>
					{section.children !== undefined && (
						<ul class="pl-2">
							{section.children?.map((child) => (
								<li>
									<a
										href={child.link}
										class="hover:underline"
										aria-current={child.link === pathname ? "true" : "false"}
									>
										{child.text}
									</a>
									{child.children !== undefined && child.link === pathname && (
										<ul class="pl-2">
											{child.children?.map((nested) => (
												<li>
													<a
														href={nested.link}
														class="hover:underline text-sm"
														aria-current={
															nested.link === pathname ? "true" : "false"
														}
													>
														{nested.text}
													</a>
												</li>
											))}
										</ul>
									)}
								</li>
							))}
						</ul>
					)}
				</li>
			))
		}
	</ul>
</nav>
