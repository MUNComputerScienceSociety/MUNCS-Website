---
import Main from "../../../layouts/Main.astro";
import { data } from "../../../data/elections/fall-2022-election.js";

const archivedPhotos = {
  "ethan.jpg": "https://web.archive.org/web/20250803133220/https://www.cs.mun.ca/~csclub/assets/elections/fall-2022/ethan.jpg",
  "jeff.jpeg": "https://web.archive.org/web/20250803133217/https://www.cs.mun.ca/~csclub/assets/elections/fall-2022/jeff.jpeg",
  "amelie.png": "https://web.archive.org/web/20250803133204/https://www.cs.mun.ca/~csclub/assets/elections/fall-2022/amelie.png",
  "kanika.jpg": "https://web.archive.org/web/20250803133208/https://www.cs.mun.ca/~csclub/assets/elections/fall-2022/kanika.jpg",
  "parsa.jpg": "https://web.archive.org/web/20250803133214/https://www.cs.mun.ca/~csclub/assets/elections/fall-2022/parsa.jpg",
  "ripu.jpg": "https://web.archive.org/web/20250803133229/https://www.cs.mun.ca/~csclub/assets/elections/fall-2022/ripu.jpg",
  "muhammed.jpg": "https://web.archive.org/web/20250803133233/https://www.cs.mun.ca/~csclub/assets/elections/fall-2022/muhammed.jpg",
  "leah.jpg": "https://web.archive.org/web/20250803133231/https://www.cs.mun.ca/~csclub/assets/elections/fall-2022/leah.jpg"
};

const roleToCandidates = {};

data.forEach((candidate) => {
	candidate.roles.split(",").map((rawRole) => {
		const role = rawRole.trim();

		if (roleToCandidates[role] === undefined) {
			roleToCandidates[role] = [];
		}

		roleToCandidates[role].push(candidate);
	});
});
---

<Main title="Fall 2022 Election Candidates">
	<h1>Fall 2022 Election Candidates</h1>

	<div class="my-6">
		{
			Object.entries(roleToCandidates).map(([role, candidates]: [any, any]) => (
				<>
					<h2 class="font-semibold mt-4">{role}</h2>
					{/* Previously:
{candidates.map(({ fullName, image }) => (
						<>
							{image !== "" && (
								<>
									<a href={`#${fullName}`}>
										<img
											class="m-2 w-[6rem] inline-block"
											src={`https://www.cs.mun.ca/~csclub/assets/elections/fall-2022/${image}`}
										/>
									</a>
								</>
							)}
						</>
					))}
*/}
                    <ul class="list-disc pl-6">
                        {candidates.map(({ fullName }) => (
                            <li><a href={`#${fullName}`} class="underline">{fullName}</a></li>
                        ))}
                    </ul>
				</>
			))
		}
	</div>

	<hr />

	{
		data.map(
			({
				image,
				fullName,
				whyInterested,
				csInterest,
				experience,
				roles,
				currentExec,
			}) => (
				<div class="my-16">
					<a href={`#${fullName}`}>
						<h1 class="text-xl font-bold" id={fullName}>
							{fullName}
							<span class="opacity-80 italic">
								{currentExec === "TRUE" &&
									" (Current executive, up for re-election)"}
							</span>
						</h1>
					</a>

					{/* Previously:
{image !== "" && (
						<img
							class="my-4 w-[16rem] mx-auto"
							src={`https://www.cs.mun.ca/~csclub/assets/elections/fall-2022/${image}`}
						/>
					)}
*/}

                    {archivedPhotos[image] && (
                        <p class="my-4">
                            <a href={archivedPhotos[image]} class="underline">View candidate photo (Internet Archive)</a>
                        </p>
                    )}

					<div class="px-1">
						{whyInterested !== "" && (
							<>
								<h2 class="text-lg italic mt-2 opacity-80">
									Why are you interested in becoming an executive?
								</h2>
								<p class="whitespace-pre-line">{whyInterested}</p>
							</>
						)}

						{csInterest !== "" && (
							<>
								<h2 class="text-lg italic mt-2 opacity-80">
									How long have you been in CS? What about CS interests you?
								</h2>
								<p class="whitespace-pre-line">{csInterest}</p>
							</>
						)}

						{experience !== "" && (
							<>
								<h2 class="text-lg italic mt-2 opacity-80">
									Have you had any preexisting experience that would assist you
									in the roles you are applying for?
								</h2>
								<p class="whitespace-pre-line">{experience}</p>
							</>
						)}

						{roles !== "" && (
							<>
								<h2 class="text-lg italic mt-2 opacity-80">
									Which positions are you interested in?
								</h2>
								<p class="whitespace-pre-line">{roles}</p>
							</>
						)}
					</div>
				</div>
			)
		)
	}
</Main>
